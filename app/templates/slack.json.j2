{% autoescape false %}{
    "blocks": [
        {
            "type": "header",
            "text": {
                "type": "plain_text",
                "text": "{{ priority_emoji | json_escape }} {{ title | json_escape }}"
            }
        },
        {
            "type": "section",
            "text": {
                "type": "mrkdwn",
                "text": "{% if subject_type == 'Subject1' %}Do: {{ buyer_name | json_escape }} - NIP {{ buyer_nip | json_escape }}{% elif subject_type == 'Subject2' %}Od: {{ seller_name | json_escape }} - NIP {{ seller_nip | json_escape }}{% else %}Od: {{ seller_name | json_escape }} - NIP {{ seller_nip | json_escape }}\nDo: {{ buyer_name | json_escape }} - NIP {{ buyer_nip | json_escape }}{% endif %}\nNr Faktury: {{ invoice_number | json_escape }}\nData: {{ issue_date | date | json_escape }}\nBrutto: *{{ gross_amount | money_raw | json_escape }} {{ currency | json_escape }}*\nNumer KSeF: {{ ksef_number | json_escape }}"
            }
        }
        {% if url %}
        ,{
            "type": "actions",
            "elements": [
                {
                    "type": "button",
                    "text": {
                        "type": "plain_text",
                        "text": "View in KSeF"
                    },
                    "url": "{{ url | json_escape }}"
                }
            ]
        }
        {% endif %}
    ],
    "attachments": [
        {
            "color": "{{ priority_color | json_escape }}",
            "fallback": "{{ title | json_escape }}"
        }
    ]
}
{% endautoescape %}
