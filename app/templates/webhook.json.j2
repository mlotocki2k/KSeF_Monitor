{% autoescape false %}{
    "title": "{{ title | json_escape }}",
    "message": "{% if subject_type == 'Subject1' %}Do: {{ buyer_name | json_escape }} - NIP {{ buyer_nip | json_escape }}{% elif subject_type == 'Subject2' %}Od: {{ seller_name | json_escape }} - NIP {{ seller_nip | json_escape }}{% else %}Od: {{ seller_name | json_escape }} - NIP {{ seller_nip | json_escape }}\nDo: {{ buyer_name | json_escape }} - NIP {{ buyer_nip | json_escape }}{% endif %}\nNr Faktury: {{ invoice_number | json_escape }}\nData: {{ issue_date | date | json_escape }}\nBrutto: {{ gross_amount | money_raw | json_escape }} {{ currency | json_escape }}\nNumer KSeF: {{ ksef_number | json_escape }}",
    "priority": {{ priority | json_number }},
    "priority_name": "{{ priority_name | json_escape }}",
    "timestamp": "{{ timestamp | json_escape }}",
    "source": "ksef-monitor",
    "invoice": {
        "ksef_number": "{{ ksef_number | json_escape }}",
        "invoice_number": "{{ invoice_number | json_escape }}",
        "issue_date": "{{ issue_date | json_escape }}",
        "gross_amount": {{ gross_amount | json_number }},
        "net_amount": {{ net_amount | json_number }},
        "vat_amount": {{ vat_amount | json_number }},
        "currency": "{{ currency | json_escape }}",
        "seller_name": "{{ seller_name | json_escape }}",
        "seller_nip": "{{ seller_nip | json_escape }}",
        "buyer_name": "{{ buyer_name | json_escape }}",
        "buyer_nip": "{{ buyer_nip | json_escape }}",
        "subject_type": "{{ subject_type | json_escape }}",
        "schema_type": "{{ schema_type | default('FA3') | json_escape }}"
    }
    {% if url %}
    ,"url": "{{ url | json_escape }}"
    {% endif %}
}
{% endautoescape %}
